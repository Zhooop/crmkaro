model Payment {
  id             String          @id @default(uuid()) @db.Uuid
  organisationId String          @map("organisation_id") @db.Uuid
  invoiceId      String?         @map("invoice_id") @db.Uuid
  personId       String          @map("person_id") @db.Uuid
  recordedById   String?         @map("recorded_by_id") @db.Uuid
  receiptNumber  String          @map("receipt_number") @db.VarChar(60)
  amountMinor    Int             @map("amount_minor")
  refundedMinor  Int             @default(0) @map("refunded_minor")
  method         String          @db.VarChar(60)
  reference      String?         @db.VarChar(160)
  status         PaymentStatus   @default(COMPLETED)
  receivedAt     DateTime        @map("received_at") @db.Timestamptz(6)
