model Invoice {
  id              String        @id @default(uuid()) @db.Uuid
  organisationId  String        @map("organisation_id") @db.Uuid
  personId        String        @map("person_id") @db.Uuid
  invoiceNumber   String        @map("invoice_number") @db.VarChar(60)
  issueDate       DateTime      @map("issue_date") @db.Date
  dueDate         DateTime      @map("due_date") @db.Date
  status          InvoiceStatus @default(DRAFT)
  currency        String        @default("INR") @db.Char(3)
  subtotalMinor   Int           @map("subtotal_minor")
  discountMinor   Int           @default(0) @map("discount_minor")
  taxMinor        Int           @default(0) @map("tax_minor")
  grandTotalMinor Int           @map("grand_total_minor")
  paidTotalMinor  Int           @default(0) @map("paid_total_minor")
  balanceDueMinor Int           @map("balance_due_minor")
  notes           String?       @db.VarChar(2000)
  issuedAt        DateTime?     @map("issued_at") @db.Timestamptz(6)
  voidedAt        DateTime?     @map("voided_at") @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  organisation    Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  person          Person        @relation(fields: [personId], references: [id], onDelete: Restrict)
