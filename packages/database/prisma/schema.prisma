generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum OrganisationStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum ServiceStatus {
  ACTIVE
  DISABLED
}

enum OrganisationServiceStatus {
  PENDING
  TRIAL
  ACTIVE
  DISABLED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

enum PersonStatus {
  ACTIVE
  ARCHIVED
}

enum PersonTypeCode {
  CUSTOMER
  STUDENT
  MEMBER
  EMPLOYEE
}

enum LeadStatus {
  OPEN
  CONVERTED
  LOST
}

enum FollowUpStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model User {
  id          String     @id @default(uuid()) @db.Uuid
  email       String     @unique @db.VarChar(320)
  name        String?    @db.VarChar(160)
  avatarUrl   String?    @map("avatar_url")
  status      UserStatus @default(ACTIVE)
  mfaEnabled  Boolean    @default(false) @map("mfa_enabled")
  lastLoginAt DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships      OrganisationMembership[]
  invitations      OrganisationMembership[] @relation("MembershipInviter")
  auditLogs        AuditLog[]
  sessions         AuthSession[]
  oauthAccounts    OAuthAccount[]
  personActivities PersonActivity[]
  leadNotes        LeadNote[]
  leadActivities   LeadActivity[]

  @@map("users")
}

model AuthSession {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  tokenHash            String    @unique @map("token_hash") @db.Char(64)
  activeOrganisationId String?   @map("active_organisation_id") @db.Uuid
  expiresAt            DateTime  @map("expires_at") @db.Timestamptz(6)
  lastSeenAt           DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  revokedAt            DateTime? @map("revoked_at") @db.Timestamptz(6)
  ipAddress            String?   @map("ip_address") @db.Inet
  userAgent            String?   @map("user_agent") @db.VarChar(500)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganisation Organisation? @relation("ActiveOrganisationSessions", fields: [activeOrganisationId], references: [id], onDelete: SetNull)

  @@index([userId, expiresAt])
  @@index([activeOrganisationId])
  @@map("auth_sessions")
}

model EmailOtpChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  email      String    @db.VarChar(320)
  codeHash   String    @map("code_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  requestIp  String?   @map("request_ip") @db.Inet
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([email, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("email_otp_challenges")
}

model OAuthAccount {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  provider          String   @db.VarChar(40)
  providerAccountId String   @map("provider_account_id") @db.VarChar(255)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@map("oauth_accounts")
}

model OAuthState {
  id          String    @id @default(uuid()) @db.Uuid
  stateHash   String    @unique @map("state_hash") @db.Char(64)
  redirectUri String    @map("redirect_uri") @db.VarChar(500)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt  DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("oauth_states")
}

model Organisation {
  id           String             @id @default(uuid()) @db.Uuid
  name         String             @db.VarChar(180)
  slug         String             @unique @db.VarChar(120)
  businessType String?            @map("business_type") @db.VarChar(80)
  industry     String?            @db.VarChar(100)
  timezone     String             @default("Asia/Kolkata") @db.VarChar(64)
  currency     String             @default("INR") @db.Char(3)
  status       OrganisationStatus @default(ACTIVE)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships      OrganisationMembership[]
  roles            Role[]
  rolePermissions  RolePermission[]
  services         OrganisationService[]
  auditLogs        AuditLog[]
  outboxEvents     OutboxEvent[]
  activeSessions   AuthSession[]            @relation("ActiveOrganisationSessions")
  people           Person[]
  tags             Tag[]
  personTypes      PersonTypeAssignment[]
  personTags       PersonTag[]
  personActivities PersonActivity[]
  pipelines        Pipeline[]
  pipelineStages   PipelineStage[]
  leads            Lead[]
  followUps        FollowUp[]
  leadNotes        LeadNote[]
  leadActivities   LeadActivity[]

  @@map("organisations")
}

model OrganisationMembership {
  id             String           @id @default(uuid()) @db.Uuid
  organisationId String           @map("organisation_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  roleId         String           @map("role_id") @db.Uuid
  status         MembershipStatus @default(INVITED)
  invitedById    String?          @map("invited_by_id") @db.Uuid
  invitedAt      DateTime?        @map("invited_at") @db.Timestamptz(6)
  joinedAt       DateTime?        @map("joined_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  invitedBy    User?        @relation("MembershipInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  ownedLeads   Lead[]       @relation("LeadOwner")
  followUps    FollowUp[]   @relation("FollowUpAssignee")

  @@unique([organisationId, userId])
  @@index([userId, status])
  @@index([organisationId, status])
  @@map("organisation_memberships")
}

model Role {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String?  @map("organisation_id") @db.Uuid
  code           String   @db.VarChar(80)
  name           String   @db.VarChar(100)
  description    String?
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation Organisation?            @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  memberships  OrganisationMembership[]
  permissions  RolePermission[]

  @@unique([organisationId, code])
  @@index([organisationId])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(120)
  module      String   @db.VarChar(60)
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  organisationId String? @map("organisation_id") @db.Uuid
  roleId         String  @map("role_id") @db.Uuid
  permissionId   String  @map("permission_id") @db.Uuid

  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  role         Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission    @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([organisationId])
  @@map("role_permissions")
}

model Service {
  id          String        @id @default(uuid()) @db.Uuid
  code        String        @unique @db.VarChar(60)
  name        String        @db.VarChar(100)
  description String?
  status      ServiceStatus @default(ACTIVE)
  sortOrder   Int           @default(0) @map("sort_order")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  features      Feature[]
  organisations OrganisationService[]

  @@map("services")
}

model Feature {
  id          String   @id @default(uuid()) @db.Uuid
  serviceId   String   @map("service_id") @db.Uuid
  code        String   @unique @db.VarChar(100)
  name        String   @db.VarChar(120)
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@map("features")
}

model OrganisationService {
  id             String                    @id @default(uuid()) @db.Uuid
  organisationId String                    @map("organisation_id") @db.Uuid
  serviceId      String                    @map("service_id") @db.Uuid
  status         OrganisationServiceStatus @default(PENDING)
  configuration  Json                      @default("{}")
  activatedAt    DateTime?                 @map("activated_at") @db.Timestamptz(6)
  disabledAt     DateTime?                 @map("disabled_at") @db.Timestamptz(6)
  createdAt      DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@unique([organisationId, serviceId])
  @@index([organisationId, status])
  @@map("organisation_services")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String?  @map("organisation_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String   @db.VarChar(120)
  entityType     String?  @map("entity_type") @db.VarChar(100)
  entityId       String?  @map("entity_id") @db.Uuid
  changes        Json?
  metadata       Json?
  requestId      String?  @map("request_id") @db.Uuid
  ipAddress      String?  @map("ip_address") @db.Inet
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  actor        User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organisationId, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

model OutboxEvent {
  id             String       @id @default(uuid()) @db.Uuid
  organisationId String?      @map("organisation_id") @db.Uuid
  aggregateType  String       @map("aggregate_type") @db.VarChar(100)
  aggregateId    String?      @map("aggregate_id") @db.Uuid
  eventType      String       @map("event_type") @db.VarChar(140)
  payload        Json
  status         OutboxStatus @default(PENDING)
  attempts       Int          @default(0)
  availableAt    DateTime     @default(now()) @map("available_at") @db.Timestamptz(6)
  publishedAt    DateTime?    @map("published_at") @db.Timestamptz(6)
  lastError      String?      @map("last_error")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([organisationId, createdAt(sort: Desc)])
  @@map("outbox_events")
}

model Person {
  id                     String       @id @default(uuid()) @db.Uuid
  organisationId         String       @map("organisation_id") @db.Uuid
  displayName            String       @map("display_name") @db.VarChar(180)
  primaryPhone           String?      @map("primary_phone") @db.VarChar(32)
  primaryPhoneNormalised String?      @map("primary_phone_normalised") @db.VarChar(24)
  alternatePhone         String?      @map("alternate_phone") @db.VarChar(32)
  email                  String?      @db.VarChar(320)
  emailNormalised        String?      @map("email_normalised") @db.VarChar(320)
  address                Json?        @map("address_json")
  status                 PersonStatus @default(ACTIVE)
  notes                  String?
  archivedAt             DateTime?    @map("archived_at") @db.Timestamptz(6)
  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation Organisation           @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  types        PersonTypeAssignment[]
  tags         PersonTag[]
  activities   PersonActivity[]
  leads        Lead[]

  @@index([organisationId, status, displayName])
  @@index([organisationId, primaryPhoneNormalised])
  @@index([organisationId, emailNormalised])
  @@map("people")
}

model PersonTypeAssignment {
  organisationId String         @map("organisation_id") @db.Uuid
  personId       String         @map("person_id") @db.Uuid
  type           PersonTypeCode
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  person       Person       @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([personId, type])
  @@index([organisationId, type])
  @@map("person_types")
}

model Tag {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  name           String   @db.VarChar(80)
  colour         String   @default("#64748B") @db.VarChar(7)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  people       PersonTag[]

  @@unique([organisationId, name])
  @@index([organisationId])
  @@map("tags")
}

model PersonTag {
  organisationId String   @map("organisation_id") @db.Uuid
  personId       String   @map("person_id") @db.Uuid
  tagId          String   @map("tag_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  person       Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  tag          Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([personId, tagId])
  @@index([organisationId, tagId])
  @@map("person_tags")
}

model PersonActivity {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  personId       String   @map("person_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String   @db.VarChar(100)
  summary        String   @db.VarChar(240)
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  person       Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organisationId, personId, createdAt(sort: Desc)])
  @@map("person_activities")
}

model Pipeline {
  id             String          @id @default(uuid()) @db.Uuid
  organisationId String          @map("organisation_id") @db.Uuid
  name           String          @db.VarChar(100)
  isDefault      Boolean         @default(false) @map("is_default")
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  organisation   Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  stages         PipelineStage[]
  leads          Lead[]

  @@unique([organisationId, name])
  @@index([organisationId, isActive])
  @@map("pipelines")
}

model PipelineStage {
  id             String       @id @default(uuid()) @db.Uuid
  organisationId String       @map("organisation_id") @db.Uuid
  pipelineId     String       @map("pipeline_id") @db.Uuid
  name           String       @db.VarChar(100)
  position       Int
  colour         String       @default("#64748B") @db.VarChar(7)
  isConverted    Boolean      @default(false) @map("is_converted")
  isLost         Boolean      @default(false) @map("is_lost")
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  pipeline       Pipeline     @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  leads          Lead[]

  @@unique([pipelineId, name])
  @@unique([pipelineId, position])
  @@index([organisationId, isActive])
  @@map("pipeline_stages")
}

model Lead {
  id                 String                  @id @default(uuid()) @db.Uuid
  organisationId     String                  @map("organisation_id") @db.Uuid
  personId           String?                 @map("person_id") @db.Uuid
  pipelineId         String                  @map("pipeline_id") @db.Uuid
  stageId            String                  @map("stage_id") @db.Uuid
  ownerMembershipId  String?                 @map("owner_membership_id") @db.Uuid
  name               String                  @db.VarChar(180)
  phone              String?                 @db.VarChar(32)
  phoneNormalised    String?                 @map("phone_normalised") @db.VarChar(24)
  email              String?                 @db.VarChar(320)
  emailNormalised    String?                 @map("email_normalised") @db.VarChar(320)
  source             String?                 @db.VarChar(80)
  expectedValueMinor Int?                    @map("expected_value_minor")
  status             LeadStatus              @default(OPEN)
  lostReason         String?                 @map("lost_reason") @db.VarChar(500)
  convertedAt        DateTime?               @map("converted_at") @db.Timestamptz(6)
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  organisation       Organisation            @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  person             Person?                 @relation(fields: [personId], references: [id], onDelete: SetNull)
  pipeline           Pipeline                @relation(fields: [pipelineId], references: [id], onDelete: Restrict)
  stage              PipelineStage           @relation(fields: [stageId], references: [id], onDelete: Restrict)
  owner              OrganisationMembership? @relation("LeadOwner", fields: [ownerMembershipId], references: [id], onDelete: SetNull)
  followUps          FollowUp[]
  notes              LeadNote[]
  activities         LeadActivity[]

  @@index([organisationId, status, stageId])
  @@index([organisationId, ownerMembershipId])
  @@index([organisationId, phoneNormalised])
  @@index([organisationId, emailNormalised])
  @@map("leads")
}

model FollowUp {
  id                     String                  @id @default(uuid()) @db.Uuid
  organisationId         String                  @map("organisation_id") @db.Uuid
  leadId                 String                  @map("lead_id") @db.Uuid
  assignedToMembershipId String?                 @map("assigned_to_membership_id") @db.Uuid
  dueAt                  DateTime                @map("due_at") @db.Timestamptz(6)
  status                 FollowUpStatus          @default(SCHEDULED)
  outcome                String?                 @db.VarChar(1000)
  completedAt            DateTime?               @map("completed_at") @db.Timestamptz(6)
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  organisation           Organisation            @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  lead                   Lead                    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedTo             OrganisationMembership? @relation("FollowUpAssignee", fields: [assignedToMembershipId], references: [id], onDelete: SetNull)

  @@index([organisationId, status, dueAt])
  @@index([organisationId, assignedToMembershipId, dueAt])
  @@map("follow_ups")
}

model LeadNote {
  id             String       @id @default(uuid()) @db.Uuid
  organisationId String       @map("organisation_id") @db.Uuid
  leadId         String       @map("lead_id") @db.Uuid
  actorUserId    String?      @map("actor_user_id") @db.Uuid
  body           String       @db.VarChar(5000)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor          User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organisationId, leadId, createdAt(sort: Desc)])
  @@map("lead_notes")
}

model LeadActivity {
  id             String       @id @default(uuid()) @db.Uuid
  organisationId String       @map("organisation_id") @db.Uuid
  leadId         String       @map("lead_id") @db.Uuid
  actorUserId    String?      @map("actor_user_id") @db.Uuid
  action         String       @db.VarChar(100)
  summary        String       @db.VarChar(240)
  metadata       Json?
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor          User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organisationId, leadId, createdAt(sort: Desc)])
  @@map("lead_activities")
}
