{
  "name": "crmkaro",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:format": "pnpm --filter @crmkaro/database db:format",
    "db:validate": "pnpm --filter @crmkaro/database db:validate",
    "db:generate": "pnpm --filter @crmkaro/database db:generate",
    "db:migrate": "pnpm --filter @crmkaro/database db:migrate",
    "db:deploy": "pnpm --filter @crmkaro/database db:deploy",
    "db:seed": "pnpm --filter @crmkaro/database db:seed",
    "db:test:tenant": "pnpm --filter @crmkaro/database db:test:tenant"
  },
  "devDependencies": {
    "@types/node": "latest",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.2",
    "prettier": "latest",
    "turbo": "latest",
    "typescript": "~6.0.2"
  }
}
